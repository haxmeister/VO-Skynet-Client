<rml>
<head>
<title>Skynet UI</title>
<style>
/* VO RmlUi has no default HTML/scrollbar styles. All dimensions are explicit.
   CRITICAL: RmlUi RGBA alpha is 0..255, not the browser's 0..1!
   rgba(7, 20, 36, 166) is roughly 65% opaque (35% transparent). */
div, form { display: block; }
body { width: 100%; height: 100%; margin: 0; padding: 0; font-size: 13px; color: #e4ecf6; }
#skynet-panel {
    position: absolute;
    left: 190px;
    top: 635px;
    width: 644px;
    height: 166px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* Let the three content columns and the SKYNET tab carry the tint.
       The outer shell stays clear instead of forming a broad dark window. */
    background-color: transparent;
    border-width: 0px;
    border-color: transparent;
    border-radius: 5px;
}
#skynet-header {
    /* The SKYNET name and connection state stay visible in every mode.
       There is no title-bar rule or background chrome during flight. */
    display: flex;
    flex: 0 0 auto;
    box-sizing: border-box;
    width: 100%;
    height: 25px;
    min-height: 25px;
    justify-content: space-between;
    align-items: flex-end;
    padding: 0px 3px;
    color: #75b9e8;
    font-size: 12px;
    letter-spacing: 1px;
    border-bottom-width: 0px;
    drag: drag;
}
/* One smooth tab with a larger top-right radius. No staircase elements
   or transforms; RmlUi renders the rounded background directly. */
#skynet-tab {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    height: 24px;
}
#skynet-identity {
    display: flex;
    flex-direction: row;
    align-items: center;
    box-sizing: border-box;
    height: 24px;
    padding: 3px 9px;
    background-color: rgba(7, 20, 36, 166);
    border-radius: 5px 14px 0px 0px;
}
#skynet-title {
    font-weight: bold;
    color: #f5a44b;
}
#skynet-controls { display: flex; flex-direction: row; align-items: center; }
#connection-status { margin-left: 4px; }
#layout-done {
    display: none;
    padding: 2px 6px;
    color: #b8eaff;
    background-color: #244e6c;
    border-width: 1px;
    border-color: #65a3c6;
    drag: block;
}
#layout-done:hover { background-color: #377397; }
.status-on { color: #69e0aa; }
.status-off { color: #e47c7c; }
#skynet-columns {
    display: flex;
    flex-direction: row;
    flex: 0 0 auto;
    box-sizing: border-box;
    width: 100%;
    overflow: hidden;
    /* A SINGLE background behind all columns and both 8px splitter gaps.
       This prevents unfilled gutters and avoids double-tinting the columns.
       Align the tab directly to the row; retain geometry/scrolling padding. */
    padding: 0px 3px 4px;
    min-height: 0;
    background-color: rgba(7, 20, 36, 166);
}
.section {
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
    box-sizing: border-box;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
    padding: 3px 5px;
    /* The shared #skynet-columns background also fills splitter gutters;
       transparent sections prevent stacking alpha and darkening columns. */
    background-color: transparent;
}
.scroller {
    display: block;
    flex: 0 0 auto;
    box-sizing: border-box;
    overflow-x: hidden;
    overflow-y: auto;
    min-height: 0;
    width: 100%;
}
#online-panel { width: 180px; }
#online-list { white-space: nowrap; }
.online-row { display: block; margin-bottom: 3px; }
#chat-panel {
    width: 290px;
    /* Anchor the fade to the chat history, not to the whole HUD. */
    position: relative;
}
#chat-top-fade {
    display: none;
    position: absolute;
    /* Begin at the actual top edge of the text viewport. The prior
       11px inset left the first chat line unfaded; extend the band
       downward instead to preserve the soft vanishing distance. */
    top: 0px;
    left: 5px;
    height: 37px;
    /* ui.lua gives this an exact width, stopping before the scrollbar. */
    width: 250px;
    pointer-events: none;
    /* Draw OVER the list, blending text into the navy as it exits at top.
       RmlUi's vertical-gradient decorator uses vertex colors and does
       not require advanced shader/mask support. */
    decorator: vertical-gradient(
        rgba(7, 20, 36, 240) rgba(7, 20, 36, 0)
    );
}
#chat-list {
    overflow-y: scroll;
    word-break: break-word;
    white-space: normal;
}
.chat-row { display: block; margin-bottom: 3px; white-space: normal; word-break: break-word; }
#sightings-panel { width: 150px; }
#sightings-list { white-space: nowrap; }
.sighting-row { display: flex; margin-bottom: 3px; }
.sighting-pilot { margin-right: 9px; }
.sighting-ship { color: #d7e3ed; margin-right: 9px; }
.sighting-sector { margin-right: 9px; }
.sighting-age { color: #93a4b3; }

/* Dragging enabled during /skynetui layout. Fine vertical split handles. */
.splitter {
    display: block;
    flex: 0 0 auto;
    box-sizing: border-box;
    width: 8px;
    height: 100%;
    min-width: 8px;
    /* This remains the unchanged 8px drag target. Draw the single line
       using the 1px child rather than an alpha border: VO can make
       translucent border colors disappear entirely. */
    background-color: transparent;
    border-width: 0px;
    drag: drag;
}
.splitter-guide {
    display: block;
    width: 1px;
    /* No column titles: guides run from the top to the bottom of
       each full-height splitter. ui.lua sets the exact height. */
    margin-top: 0px;
    height: 100%;
    background-color: #4c7188;
    pointer-events: none;
}
.splitter:hover { background-color: transparent; }
#skynet-panel.layout-edit .splitter:hover {
    background-color: rgba(64, 138, 170, 204);
}
#resize-grip {
    position: absolute;
    display: none; /* Only shown while /skynetui layout is active. */
    right: 1px;
    bottom: 1px;
    width: 15px;
    height: 15px;
    background-color: rgba(57, 130, 160, 204);
    border-width: 1px;
    border-color: #8cc6e0;
    drag: drag;
}
#resize-grip:hover { background-color: #69b9da; }

/* Chat input is a reserved, non-scrolling bottom row of the chat column. */
#chat-form {
    display: none;
    flex: 0 0 auto;
    box-sizing: border-box;
    width: 100%;
    height: 29px;
    min-height: 29px;
    padding-top: 3px;
    border-top-width: 1px;
    border-top-color: #3d7897;
}
#chat-input {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: 24px;
    min-height: 24px;
    margin: 0;
    padding: 2px 5px;
    color: #f3faff;
    /* Strong contrast even when the HUD panel is nearly invisible. */
    background-color: rgba(16, 40, 59, 240);
    border-width: 1px;
    border-color: #75badb;
    font-size: 13px;
    drag: block;
}
#chat-input:focus {
    background-color: #16354e;
    border-color: #a0dfff;
}

/* Keep RmlUi scrollbars generated and their 11px width intact, so
   overflow, scrolling and word wrapping never change between modes.
   Only their paint is hidden during normal flight. */
scrollbarvertical {
    width: 11px;
    background-color: transparent;
}
scrollbarvertical slidertrack {
    width: 11px;
    background-color: transparent;
}
scrollbarvertical sliderbar {
    width: 9px;
    min-height: 18px;
    background-color: transparent;
}
scrollbarvertical sliderbar:hover { background-color: transparent; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc {
    width: 0px;
    height: 0px;
}
/* RmlUi generates scrollbars as children of their scroll containers.
   ui.lua toggles this parent class for layout mode. */
#skynet-panel.layout-edit scrollbarvertical {
    background-color: #122d40;
}
#skynet-panel.layout-edit scrollbarvertical slidertrack {
    background-color: #1c455d;
}
#skynet-panel.layout-edit scrollbarvertical sliderbar {
    background-color: #71b5d6;
}
#skynet-panel.layout-edit scrollbarvertical sliderbar:hover {
    background-color: #a1d9f0;
}
</style>
</head>
<body>
  <div id="skynet-panel">
    <div id="skynet-header">
      <div id="skynet-tab">
        <div id="skynet-identity">
          <span id="skynet-title">SKYNET:</span>
          <span id="connection-status">DISCONNECTED</span>
        </div>
      </div>
      <div id="skynet-controls">
        <span id="layout-done">DONE</span>
      </div>
    </div>
    <div id="skynet-columns">
      <div id="online-panel" class="section">
        <div id="online-list" class="scroller"></div>
      </div>
      <div id="split-left" class="splitter"><div id="split-left-guide" class="splitter-guide"></div></div>
      <div id="chat-panel" class="section">
        <div id="chat-list" class="scroller"></div>
        <form id="chat-form">
          <input id="chat-input" type="text" name="message" maxlength="300" autocomplete="off" />
        </form>
        <div id="chat-top-fade"></div>
      </div>
      <div id="split-right" class="splitter"><div id="split-right-guide" class="splitter-guide"></div></div>
      <div id="sightings-panel" class="section">
        <div id="sightings-list" class="scroller"></div>
      </div>
    </div>
    <div id="resize-grip"></div>
  </div>
</body>
</rml>
