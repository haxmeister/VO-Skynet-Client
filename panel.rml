<rml>
<head>
<title>Skynet UI</title>
<style>
/* VO RmlUi has no default HTML/scrollbar styles. All dimensions are explicit. */
div, form { display: block; }
body { width: 100%; height: 100%; margin: 0; padding: 0; font-size: 13px; color: #e4ecf6; }
#skynet-panel {
    position: absolute;
    left: 190px;
    top: 635px;
    width: 644px;
    height: 166px;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    /* Normal flight: a restrained tint, no visible window outline.
       /skynetui layout restores a stronger frame via ui.lua. */
    background-color: rgba(7, 20, 36, 0.72);
    border-width: 0px;
    border-color: transparent;
    border-radius: 5px;
}
#skynet-header {
    /* Layout-only chrome; ui.lua switches this to flex while editing. */
    display: none;
    flex: 0 0 auto;
    box-sizing: border-box;
    width: 100%;
    height: 25px;
    min-height: 25px;
    justify-content: space-between;
    align-items: center;
    padding: 2px 9px;
    color: #7fc9ff;
    font-size: 12px;
    letter-spacing: 1px;
    border-bottom-width: 1px;
    border-bottom-color: #294d68;
    drag: drag;
}
#skynet-title { font-weight: bold; }
#skynet-controls { display: flex; flex-direction: row; align-items: center; }
#connection-status { margin-right: 9px; }
#layout-done {
    display: none;
    padding: 2px 6px;
    color: #b8eaff;
    background-color: #244e6c;
    border-width: 1px;
    border-color: #65a3c6;
    drag: block;
}
#layout-done:hover { background-color: #377397; }
.status-on { color: #69e0aa; }
.status-off { color: #e47c7c; }
#skynet-columns {
    display: flex;
    flex-direction: row;
    flex: 0 0 auto;
    box-sizing: border-box;
    width: 100%;
    overflow: hidden;
    padding: 2px 3px;
    min-height: 0;
}
.section {
    display: flex;
    flex-direction: column;
    flex: 0 0 auto;
    box-sizing: border-box;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
    padding: 3px 5px;
}
.heading {
    display: block;
    flex: 0 0 auto;
    box-sizing: border-box;
    height: 18px;
    min-height: 18px;
    font-weight: bold;
    font-size: 11px;
    color: #8bcdf4;
    white-space: nowrap;
}
.scroller {
    display: block;
    flex: 0 0 auto;
    box-sizing: border-box;
    overflow-x: hidden;
    overflow-y: auto;
    min-height: 0;
    width: 100%;
}
#online-panel { width: 180px; }
#online-list { white-space: nowrap; }
.online-row { display: block; margin-bottom: 3px; }
#chat-panel { width: 290px; }
#chat-list {
    overflow-y: scroll;
    word-break: break-word;
    white-space: normal;
}
.chat-row { display: block; margin-bottom: 3px; white-space: normal; word-break: break-word; }
#sightings-panel { width: 150px; }
#sightings-list { white-space: nowrap; }
.sighting-row { display: flex; margin-bottom: 3px; }
.sighting-pilot { margin-right: 9px; }
.sighting-ship { color: #d7e3ed; margin-right: 9px; }
.sighting-sector { margin-right: 9px; }
.sighting-age { color: #93a4b3; }

/* Dragging enabled during /skynetui layout. Fine vertical split handles. */
.splitter {
    display: block;
    flex: 0 0 auto;
    box-sizing: border-box;
    width: 8px;
    height: 100%;
    min-width: 8px;
    /* One visual separator, with an 8px drag hit area. */
    background-color: transparent;
    border-width: 0px;
    /* Layout mode turns on this single separator line. Keep the 8px
       draggable region and the three column widths unchanged. */
    border-left-width: 0px;
    border-color: #386984;
    drag: drag;
}
.splitter:hover { background-color: rgba(64, 138, 170, 0.80); }
#resize-grip {
    position: absolute;
    display: none; /* Only shown while /skynetui layout is active. */
    right: 1px;
    bottom: 1px;
    width: 15px;
    height: 15px;
    background-color: rgba(57, 130, 160, 0.80);
    border-width: 1px;
    border-color: #8cc6e0;
    drag: drag;
}
#resize-grip:hover { background-color: #69b9da; }

/* Chat input is a reserved, non-scrolling bottom row of the chat column. */
#chat-form {
    display: none;
    flex: 0 0 auto;
    box-sizing: border-box;
    width: 100%;
    height: 29px;
    min-height: 29px;
    padding-top: 3px;
    border-top-width: 1px;
    border-top-color: #3d7897;
}
#chat-input {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: 24px;
    min-height: 24px;
    margin: 0;
    padding: 2px 5px;
    color: #f3faff;
    /* Strong contrast even when the HUD panel is nearly invisible. */
    background-color: rgba(16, 40, 59, 0.94);
    border-width: 1px;
    border-color: #75badb;
    font-size: 13px;
    drag: block;
}
#chat-input:focus {
    background-color: #16354e;
    border-color: #a0dfff;
}

/* RmlUi does not style generated scrollbar elements by default. */
scrollbarvertical {
    width: 11px;
    background-color: #122d40;
}
scrollbarvertical slidertrack {
    width: 11px;
    background-color: #1c455d;
}
scrollbarvertical sliderbar {
    width: 9px;
    min-height: 18px;
    background-color: #71b5d6;
}
scrollbarvertical sliderbar:hover { background-color: #a1d9f0; }
scrollbarvertical sliderarrowdec, scrollbarvertical sliderarrowinc {
    width: 0px;
    height: 0px;
}
</style>
</head>
<body>
  <div id="skynet-panel">
    <div id="skynet-header">
      <span id="skynet-title">SKYNET</span>
      <div id="skynet-controls">
        <span id="connection-status">DISCONNECTED</span>
        <span id="layout-done">DONE</span>
      </div>
    </div>
    <div id="skynet-columns">
      <div id="online-panel" class="section">
        <div class="heading">ONLINE (<span id="online-count">0</span>)</div>
        <div id="online-list" class="scroller"></div>
      </div>
      <div id="split-left" class="splitter"></div>
      <div id="chat-panel" class="section">
        <div class="heading">ALLIANCE CHAT</div>
        <div id="chat-list" class="scroller"></div>
        <form id="chat-form">
          <input id="chat-input" type="text" name="message" maxlength="300" autocomplete="off" />
        </form>
      </div>
      <div id="split-right" class="splitter"></div>
      <div id="sightings-panel" class="section">
        <div class="heading">SIGHTINGS</div>
        <div id="sightings-list" class="scroller"></div>
      </div>
    </div>
    <div id="resize-grip"></div>
  </div>
</body>
</rml>
